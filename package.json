{
  "name": "vue-group-sheet-desktop",
  "version": "1.0.2",
  "main": "main.js",
  "scripts": {
    "prestart": "node build-web.js",
    "start": "electron .",
    "dev": "node dev.js",
    "dist:win": "npm run build-web && electron-builder --win nsis --x64 --publish never",
    "build-web": "node build-web.js",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Editor de partituras y colecciones para bandas musicales",
  "build": {
    "appId": "com.oskrs111.groupsheeteditor",
    "productName": "Group Sheet Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "workspace.js",
      "settings.js",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Group-Sheet-Editor-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "26.15.3"
  }
}
